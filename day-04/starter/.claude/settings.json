{
  "_comment": "Day 4 starter. Commit this to the repository so the whole team inherits one guard, rather than fifteen people configuring fifteen laptops differently. Settings load when a session starts: after you copy this in, restart the session or the guard does nothing.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(./.github/workflows/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": ".claude/guard.sh" }]
      }
    ]
  }
}
